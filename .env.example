# Copy to .env and fill in. Never commit the real .env — .gitignore covers .env*
# Validated at boot by src/lib/env.ts; an invalid value throws before the app serves anything.
# Leave a variable OUT rather than setting it empty when you want the default.

# --- Required ---------------------------------------------------------------

# PostgreSQL. Use the Neon *pooled* string in production; Prisma Client runs
# fine through the pooler. Migrations are run by hand from a developer machine.
DATABASE_URL=postgresql://tori:tori-local-password@localhost:5432/tori?schema=public

# At least 32 characters. Signs the tori_session JWT AND derives the key that
# encrypts AI API keys stored in SystemAiConfig — changing it invalidates both.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# --- Deployment -------------------------------------------------------------

# Public base URL of the deployment. Defaults to http://localhost:3000
APP_URL=http://localhost:3000

# Where uploaded TOR files go. "local" writes to LOCAL_STORAGE_PATH;
# "vercel-blob" requires BLOB_READ_WRITE_TOKEN and is the only option that
# works on Vercel, whose filesystem is read-only and not durable.
STORAGE_DRIVER=local

# Only used when STORAGE_DRIVER=local. Ignored by the vercel-blob driver.
LOCAL_STORAGE_PATH=./storage

# Injected automatically by Vercel once a Blob store is linked. Do not set by hand.
# BLOB_READ_WRITE_TOKEN=

# Vercel Functions reject request bodies over 4.5 MB before the handler runs,
# so keep this at 4 there. 20 is fine for Docker/self-hosted.
MAX_TOR_FILE_SIZE_MB=20

# --- Temporary sign-in, until CMU OIDC is configured -------------------------

# Enables POST /api/auth/mock outside development. BOTH of these must be set;
# the endpoint 404s otherwise. Delete both once CMU_* below are configured.
# ALLOW_MOCK_LOGIN=false
# MOCK_LOGIN_PASSWORD=

# --- CMU OIDC (all four required together) ----------------------------------

CMU_CLIENT_ID=
CMU_CLIENT_SECRET=
CMU_ISSUER=
CMU_REDIRECT_URI=

# --- AI ---------------------------------------------------------------------
# Optional. An ADMIN can instead configure these at /settings/ai, which stores
# them encrypted in the database and takes precedence over these values.

OPENAI_API_KEY=
OPENAI_MODEL=
# Set only when pointing at an OpenAI-compatible gateway instead of OpenAI itself.
OPENAI_BASE_URL=
OPENAI_STORE_RESPONSES=false

# --- Rarely changed ---------------------------------------------------------

# Only "mock" is implemented; there is no real OCR provider yet.
OCR_PROVIDER=mock
OCR_API_KEY=
# Only "Asia/Bangkok" is accepted.
APP_TIMEZONE=Asia/Bangkok
MAX_WORK_HOURS_PER_DAY=24
