# คัดลอกเป็น .env — .gitignore ครอบคลุม .env* ไว้แล้ว
# src/lib/env.ts ตรวจค่าตอนบูต ถ้าค่าผิดจะ throw ก่อนแอปเริ่มให้บริการ

# --- จำเป็นต้องมี --------------------------------------------------------------

# Neon: ใช้ pooled string · migration รันด้วยมือเสมอ ไม่รันตอน build
DATABASE_URL=postgresql://tori:tori-local-password@localhost:5432/tori?schema=public

# อย่างน้อย 32 ตัวอักษร ใช้เซ็น session JWT และเข้ารหัส AI key ที่เก็บในฐานข้อมูล
# เปลี่ยนค่าแล้วใช้ไม่ได้ทั้งสองอย่าง · สร้างด้วย openssl rand -base64 48
AUTH_SECRET=

# --- การ deploy -------------------------------------------------------------

# URL หลักของ deployment นี้
APP_URL=http://localhost:3000

# ที่เก็บไฟล์ TOR ที่อัปโหลด · บน Vercel ต้องใช้ vercel-blob เพราะไฟล์ในเครื่องไม่คงอยู่
STORAGE_DRIVER=local

# ใช้เมื่อ STORAGE_DRIVER=local เท่านั้น
LOCAL_STORAGE_PATH=./storage

# Vercel ใส่ให้เองเมื่อผูก Blob store แล้ว อย่าตั้งเอง
# BLOB_READ_WRITE_TOKEN=

# บน Vercel ให้ใช้ 4 เพราะ body เกิน 4.5 MB ถูกปฏิเสธก่อนถึง handler
MAX_TOR_FILE_SIZE_MB=20

# --- เข้าสู่ระบบชั่วคราว จนกว่าจะตั้งค่า Entra หรือ CMU OIDC เสร็จ ---------------------

# เปิด POST /api/auth/mock นอกโหมด development · ต้องตั้งทั้งคู่ ไม่งั้น 404
# เข้าระบบด้วยสิทธิ์ ADMIN — ลบทั้งคู่เมื่อ ENTRA_* หรือ CMU_* ใช้งานได้
# ALLOW_MOCK_LOGIN=false
# MOCK_LOGIN_PASSWORD=

# --- Microsoft Entra (ต้องครบทั้งสี่ตัว หรือไม่ใส่เลย) ---------------------------------

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# ยกสิทธิ์ ADMIN ให้ผู้ที่ล็อกอินผ่าน Entra · คั่นด้วยจุลภาคหรือขึ้นบรรทัดใหม่ · ว่างได้
ENTRA_ADMIN_EMAILS=
# object id ของ Entra group ที่ถือว่าเป็น ADMIN · รูปแบบเดียวกัน
ENTRA_ADMIN_GROUP_IDS=

# --- CMU OIDC (ต้องครบทั้งสี่ตัว หรือไม่ใส่เลย) --------------------------------------

CMU_CLIENT_ID=
CMU_CLIENT_SECRET=
CMU_ISSUER=
CMU_REDIRECT_URI=

# --- AI ---------------------------------------------------------------------
# เป็นค่าสำรอง · /settings/ai เก็บค่าเข้ารหัสไว้ในฐานข้อมูลและถูกใช้ก่อน

OPENAI_API_KEY=
OPENAI_MODEL=
# ใส่เมื่อชี้ไปยัง gateway ที่รองรับ OpenAI API เท่านั้น
OPENAI_BASE_URL=
OPENAI_STORE_RESPONSES=false

# --- แทบไม่ต้องแก้ -------------------------------------------------------------

# มีแค่ "mock" เท่านั้น
OCR_PROVIDER=mock
OCR_API_KEY=
# รับเฉพาะ "Asia/Bangkok"
APP_TIMEZONE=Asia/Bangkok
MAX_WORK_HOURS_PER_DAY=24
