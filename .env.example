DATABASE_URL=
DIRECT_URL=

AUTH_SECRET=

# CMU Account (optional)
CMU_CLIENT_ID=
CMU_CLIENT_SECRET=
CMU_ISSUER=
CMU_REDIRECT_URI=

# Microsoft Entra ID (optional) — 1 คน = 1 โปรไฟล์ (TOR แยกตาม user)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4600/api/auth/entra/callback
# อีเมลที่เป็น ADMIN (คั่นด้วยจุลภาค) — ใช้ตั้งค่า settings/ai
ENTRA_ADMIN_EMAILS=
# Object ID ของ Entra group ที่เป็น ADMIN (คั่นด้วยจุลภาค)
ENTRA_ADMIN_GROUP_IDS=

# ล็อกอินสาธิตแบบมีรหัสผ่าน (ชั่วคราวจนกว่า Entra/CMU พร้อม — ปิดเมื่อใช้จริง)
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_STORE_RESPONSES=false

# local = ดิสก์ | vercel-blob = Vercel Blob (ต้องมี BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
LOCAL_STORAGE_PATH=./storage

# งบเวลาเรียก AI ต่อครั้ง (ms) — เพดานฟังก์ชัน Vercel ~300s
AI_REQUEST_TIMEOUT_MS=240000

OCR_PROVIDER=mock
OCR_API_KEY=

APP_URL=http://localhost:4600
APP_TIMEZONE=Asia/Bangkok
# บน Vercel แนะนำ 4 เพื่อไม่ชน body limit ของฟังก์ชัน
MAX_TOR_FILE_SIZE_MB=20
MAX_WORK_HOURS_PER_DAY=24
