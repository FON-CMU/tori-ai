generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleCode {
  EMPLOYEE
  SUPERVISOR
  HR
  ADMIN
}

enum TorStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  ACTIVE
  FAILED
  ARCHIVED
}

enum ExtractionMethod {
  DIRECT
  OCR
}

enum TorCategory {
  ROUTINE
  ASSIGNED
  DEVELOPMENT
}

enum TorTopicKind {
  SECTION
  TOPIC
  SUBITEM
}

enum TopicStatus {
  DRAFT
  CONFIRMED
  REJECTED
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum WorkDraftStatus {
  COLLECTING
  READY_FOR_REVIEW
  SAVED
  CANCELLED
}

enum JaStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

enum AiPurpose {
  TOR_EXTRACTION
  WORK_EXTRACTION
  CLASSIFICATION
  DRAFTING
}

enum AiRunStatus {
  STARTED
  SUCCEEDED
  FAILED
  REFUSED
  INCOMPLETE
}

enum AiProviderPreference {
  OPENAI
  GOOGLE_AI_STUDIO
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  parent    Unit?    @relation("UnitHierarchy", fields: [parentId], references: [id])
  children  Unit[]   @relation("UnitHierarchy")
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  cmuAccount   String      @unique
  employeeId   String      @unique
  title        String?
  firstName    String
  lastName     String
  email        String      @unique
  position     String?
  unitId       String      @db.Uuid
  unit         Unit        @relation(fields: [unitId], references: [id])
  status       UserStatus  @default(ACTIVE)
  roles        UserRole[]
  torDocuments TorDocument[]
  torTopics    TorTopic[]
  conversations Conversation[]
  workDrafts   WorkDraft[]
  jaRecords    JaRecord[]
  auditLogs    AuditLog[]  @relation("AuditActor")
  aiRuns       AiRun[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([unitId])
  @@index([status])
}

model SystemAiConfig {
  id                      String               @id @default("default")
  openAiApiKeyEncrypted   String?
  openAiModel             String?
  openAiBaseUrl           String?
  /** รายการโมเดลที่ให้ผู้ใช้เลือกในแชท คั่นด้วยบรรทัดใหม่หรือจุลภาค */
  chatModels              String?
  googleAiApiKeyEncrypted String?
  googleAiModel           String?
  preferredAiProvider     AiProviderPreference @default(OPENAI)
  updatedAt               DateTime             @updatedAt
  updatedById             String?              @db.Uuid
}

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  code  RoleCode   @unique
  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model TorDocument {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  user            User       @relation(fields: [userId], references: [id])
  fileName        String
  mimeType        String
  storageKey      String     @unique
  fileHash        String
  status          TorStatus  @default(UPLOADED)
  processingError String?
  version         Int
  year            Int        @default(2569)
  effectiveAt     DateTime?
  pages           TorPage[]
  topics          TorTopic[]
  jaRecords       JaRecord[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, version])
  @@index([userId, status])
  @@index([userId, year])
  @@index([fileHash])
  @@index([createdAt])
}

model TorPage {
  id               String           @id @default(uuid()) @db.Uuid
  torDocumentId    String           @db.Uuid
  torDocument      TorDocument      @relation(fields: [torDocumentId], references: [id], onDelete: Cascade)
  pageNumber       Int
  extractedText    String
  extractionMethod ExtractionMethod
  confidence       Float?

  @@unique([torDocumentId, pageNumber])
  @@index([torDocumentId])
}

model TorTopic {
  id            String       @id @default(uuid()) @db.Uuid
  torDocumentId String       @db.Uuid
  torDocument   TorDocument  @relation(fields: [torDocumentId], references: [id], onDelete: Cascade)
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id])
  category      TorCategory
  kind          TorTopicKind @default(TOPIC)
  /// ป้ายหมวดตามฟอร์ม เช่น "3. ภาระงานเชิงพัฒนา"
  sectionLabel  String?
  code          String?
  title         String
  description   String?
  hoursPerWeek  Decimal?     @db.Decimal(6, 2)
  sortOrder     Int          @default(0)
  /// true = ใช้จับคู่ JA (ปกติเป็น TOPIC)
  matchable     Boolean      @default(true)
  parentId      String?      @db.Uuid
  parent        TorTopic?    @relation("TorTopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      TorTopic[]   @relation("TorTopicTree")
  sourcePage    Int?
  status        TopicStatus  @default(DRAFT)
  workDrafts    WorkDraft[]
  jaRecords     JaRecord[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, status])
  @@index([torDocumentId, category])
  @@index([torDocumentId, sortOrder])
  @@index([parentId])
  @@index([torDocumentId, matchable])
}

model Conversation {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  user      User               @relation(fields: [userId], references: [id])
  status    ConversationStatus @default(ACTIVE)
  title     String?
  aiModel   String?
  messages  Message[]
  workDraft WorkDraft?
  jaRecords JaRecord[]
  aiRuns    AiRun[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  metadataJson   Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model WorkDraft {
  id                  String          @id @default(uuid()) @db.Uuid
  conversationId      String          @unique @db.Uuid
  conversation        Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId              String          @db.Uuid
  user                User            @relation(fields: [userId], references: [id])
  torTopicId          String?         @db.Uuid
  torTopic            TorTopic?       @relation(fields: [torTopicId], references: [id], onDelete: SetNull)
  workTitle           String?
  category            TorCategory?
  description         String?
  relatedUnit         String?
  location            String?
  startAt             DateTime?
  endAt               DateTime?
  totalHours          Decimal?        @db.Decimal(6, 2)
  result              String?
  missingFieldsJson   Json?
  confirmedFieldsJson Json?
  aiConfidence        Float?
  status              WorkDraftStatus @default(COLLECTING)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, status])
  @@index([torTopicId])
}

model JaRecord {
  id                   String            @id @default(uuid()) @db.Uuid
  runningNumber        String            @unique
  userId               String            @db.Uuid
  user                 User              @relation(fields: [userId], references: [id])
  torDocumentId        String?           @db.Uuid
  torDocument          TorDocument?      @relation(fields: [torDocumentId], references: [id], onDelete: SetNull)
  torTopicId           String?           @db.Uuid
  torTopic             TorTopic?         @relation(fields: [torTopicId], references: [id], onDelete: SetNull)
  sourceConversationId String?           @db.Uuid
  sourceConversation   Conversation?     @relation(fields: [sourceConversationId], references: [id])
  workTitle            String
  category             TorCategory
  description          String
  relatedUnit          String?
  location             String?
  startAt              DateTime
  endAt                DateTime
  totalHours           Decimal           @db.Decimal(6, 2)
  result               String
  status               JaStatus          @default(DRAFT)
  confirmedAt          DateTime?
  versions             JaRecordVersion[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, startAt])
  @@index([createdAt])
}

model JaRecordVersion {
  id           String   @id @default(uuid()) @db.Uuid
  jaRecordId   String   @db.Uuid
  jaRecord     JaRecord @relation(fields: [jaRecordId], references: [id], onDelete: Cascade)
  version      Int
  snapshotJson Json
  changedBy    String   @db.Uuid
  changeReason String?
  createdAt    DateTime @default(now())

  @@unique([jaRecordId, version])
  @@index([jaRecordId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  objectType String
  objectId   String   @db.Uuid
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([objectType, objectId])
}

model AiRun {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id])
  conversationId   String?       @db.Uuid
  conversation     Conversation? @relation(fields: [conversationId], references: [id])
  purpose          AiPurpose
  provider         String
  model            String
  promptVersion    String
  inputTokenCount  Int?
  outputTokenCount Int?
  latencyMs        Int?
  status           AiRunStatus
  errorCode        String?
  createdAt        DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([status])
}
